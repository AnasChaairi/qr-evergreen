# Public site URL used for canonical links, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://qrevergreen.com

# Plausible analytics (optional). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google AdSense (optional). Ads render only when the client and a slot are set.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_GENERATOR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
