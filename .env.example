# Public site URL used for canonical links, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://qrevergreen.com

# Plausible analytics (optional). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google AdSense (optional). Ads render only when the client and a slot are set.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_GENERATOR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Supabase (accounts, dynamic codes, scans). The free generator works without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: used by the redirect to look up codes and log scans, and to create codes after plan checks.
SUPABASE_SECRET_KEY=

# Short links printed in dynamic codes. Defaults to $NEXT_PUBLIC_SITE_URL/q.
# Point a short domain (e.g. https://qrev.link) at this app and set it here.
NEXT_PUBLIC_SHORT_URL=

# Google Safe Browsing API key. Required in production: new and edited
# destinations are refused if the check cannot run.
GOOGLE_SAFE_BROWSING_KEY=

# Google Places API (New) key for the review kit's business search. Optional:
# without it, owners paste their review link or Place ID.
GOOGLE_PLACES_API_KEY=

# Random secret mixed into the daily visitor hash (no IPs are stored).
SCAN_HASH_SALT=
